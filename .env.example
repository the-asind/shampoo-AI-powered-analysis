NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DATABASE_PATH=./data/shampoo.sqlite

# AI provider chain: openai or anthropic. Set fallback to none to disable it.
AI_PROVIDER=openai
AI_FALLBACK_PROVIDER=anthropic
AI_TIMEOUT_MS=120000

# OpenAI-compatible endpoint. For OpenAI itself, keep /v1.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic Messages API or compatible endpoint.
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_MAX_TOKENS=1800

# Optional outbound proxy only for AI provider requests.
# HTTPS_PROXY=http://user:password@proxy-host:port
# HTTP_PROXY=http://user:password@proxy-host:port

# Google reCAPTCHA v3. Vite exposes only VITE_* variables to the browser.
VITE_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# Per-client quotas for protected actions: analyze and submit_shampoo.
RATE_LIMIT_PER_MINUTE=1
RATE_LIMIT_PER_DAY=10

# Public footer link. Vite reads this at build time.
VITE_AUTHOR_URL=https://asind.dev

# Read-only admin dashboard at /admin.
ADMIN_TOKEN=
VISIT_HASH_SALT=
