NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DATABASE_PATH=./data/shampoo.sqlite

# OpenAI-compatible endpoint. For OpenAI itself, keep /v1.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=12000

# Optional outbound proxy only for OpenAI-compatible AI requests.
# HTTPS_PROXY=http://user:password@proxy-host:port
# HTTP_PROXY=http://user:password@proxy-host:port

# Google reCAPTCHA v3. Vite exposes only VITE_* variables to the browser.
VITE_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.95

# Per-client quotas for protected actions: analyze and submit_shampoo.
RATE_LIMIT_PER_MINUTE=1
RATE_LIMIT_PER_DAY=10

# Public footer link. Vite reads this at build time.
VITE_AUTHOR_URL=https://asind.dev
